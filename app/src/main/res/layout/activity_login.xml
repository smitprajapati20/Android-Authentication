<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginRight="50dp"
        android:layout_marginTop="150dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Sign Up"
            android:textColor="@color/gray"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/btnPurple"
            android:text=" / Log In"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Good to see you back !"
        android:textStyle="bold"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginStart="65dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email / Username :"
        android:textColor="@color/btnPurple"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/poppins_medium"
        />
    <EditText
        android:id="@+id/logMail"
        android:layout_width="300dp"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_edittext"
        android:hint="smit@gmail.com"/>

    <EditText
        android:id="@+id/logPass"
        android:inputType="textPassword"
        android:layout_width="300dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:background="@drawable/custom_edittext"
        android:layout_height="wrap_content"
        android:hint="Password"/>

    <TextView
        android:id="@+id/fgpass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot pass ?"
        android:layout_marginLeft="270dp"
        android:textSize="14sp"
        android:textColor="@color/btnPurple"/>

    <Button
        android:id="@+id/Login"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="90dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Log in"
        android:background="@drawable/custom_button"
        app:backgroundTint="@null"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="or"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginStart="195dp"
        android:layout_marginTop="15dp"
        android:textSize="14sp"/>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log in with"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/google"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:layout_marginStart="5dp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"/>

    </LinearLayout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Don't have an account ?"/>

        <TextView
            android:id="@+id/SugSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/poppins_medium"
            android:text="SignUp"/>
    </LinearLayout>

</LinearLayout>