<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_back"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/main_name"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_35sdp"
        android:layout_marginRight="@dimen/_18sdp"
        android:textSize="@dimen/_15sdp"
        android:background="@drawable/custom_username"
        android:fontFamily="@font/poppins_medium"
        android:layout_gravity="end"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:layout_width="@dimen/_270sdp"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_65sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="Hello, Welcome.\n This is main Page"
        android:textSize="@dimen/_27sdp"
        android:textColor="@color/black"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="@dimen/_270sdp"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_20sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="You can Access your all functions down there"
        android:textSize="@dimen/_22sdp"
        android:textColor="@color/black"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_90sdp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_135sdp"
            app:cardCornerRadius="@dimen/_18sdp"
            android:layout_height="@dimen/_200sdp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageView
                android:layout_width="@dimen/_98sdp"
                android:layout_height="@dimen/_98sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_30sdp"
                android:background="@drawable/rounded_imf"
                android:src="@drawable/headphone"/>

            <Button
                android:id="@+id/category"
                app:backgroundTint="@null"
                android:textColor="@color/btnText"
                android:textStyle="bold"
                android:background="@drawable/custom_button"
                android:layout_width="@dimen/_98sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_gravity="center"
                android:text="Category" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_135sdp"
            app:cardCornerRadius="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_height="@dimen/_200sdp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/_98sdp"
                    android:layout_height="@dimen/_98sdp"
                    android:layout_gravity="center"
                    android:padding="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:background="@drawable/rounded_imf"
                    android:src="@drawable/user"
                    />
                <Button
                    android:id="@+id/profile_btn"
                    app:backgroundTint="@null"
                    android:textColor="@color/btnText"
                    android:textStyle="bold"
                    android:background="@drawable/custom_button"
                    android:layout_width="@dimen/_98sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_gravity="center"
                    android:text="Profile" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_280sdp"
            app:cardCornerRadius="@dimen/_18sdp"
            android:layout_height="@dimen/_65sdp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">
            <Button
                android:id="@+id/logout"
                android:layout_width="@dimen/_125sdp"
                android:textColor="@color/btnText"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                app:backgroundTint="@null"
                android:background="@drawable/custom_button"
                android:text="Log out" />
            <Button
                android:id="@+id/delete_btn"
                android:layout_width="@dimen/_125sdp"
                android:textColor="@color/btnText"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                app:backgroundTint="@null"
                android:background="@drawable/custom_button"
                android:layout_marginStart="@dimen/_7sdp"
                android:text="Delete User"/>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>

