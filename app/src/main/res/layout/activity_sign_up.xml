<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginRight="50dp"
        android:layout_marginTop="150dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Sign Up"
            android:textColor="#330576"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#786D6D"
            android:text=" / Log In"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="65dp"
        android:fontFamily="@font/poppins_medium"
        android:text="To access all the features"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="170dp"
        android:src="@drawable/outline_add_a_photo_24"
        />

    <EditText
        android:id="@+id/SignName"
        android:layout_width="300dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_edittext"
        android:hint="Smit Prajapati"/>


    <EditText
        android:id="@+id/SignMail"
        android:layout_width="300dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_edittext"
        android:inputType="textEmailAddress"
        android:hint="smit@gmail.com"/>

    <EditText
        android:id="@+id/SignContact"
        android:layout_width="300dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_edittext"
        android:inputType="phone"
        android:hint="Contact No"/>

    <EditText
        android:id="@+id/SignPass"
        android:inputType="textPassword"
        android:layout_width="300dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:background="@drawable/custom_edittext"
        android:layout_height="wrap_content"
        android:hint="Password"/>

    <EditText
        android:id="@+id/SignConfirmPass"
        android:inputType="textPassword"
        android:layout_width="300dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginHorizontal="60dp"
        android:background="@drawable/custom_edittext"
        android:layout_height="wrap_content"
        android:hint="Confirm Password"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/CB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginLeft="-10dp"
            android:textSize="12sp"
            android:text="i agree to all the"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textStyle="bold"
            android:layout_marginLeft="5dp"
            android:textSize="12sp"
            android:text="Terms &amp; Condition"/>

    </LinearLayout>
    <Button
        android:id="@+id/SignUp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Sign Up"
        app:backgroundTint = "@null"
        android:background="@drawable/custom_button"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="or"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginStart="195dp"
        android:layout_marginTop="5dp"
        android:textSize="14sp"/>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up with"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/google"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google"
            android:layout_marginStart="5dp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Already have an account ?" />

        <TextView
            android:id="@+id/SugLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Login"/>
    </LinearLayout>

</LinearLayout>